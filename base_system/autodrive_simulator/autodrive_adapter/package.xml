<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>autodrive_adapter</name>
  <version>0.0.1</version>
  <description>Makes the AutoDRIVE simulator look like the car hardware (VESC, IMU, LiDAR) to the race stack.</description>
  <maintainer email="djdisco33@gmail.com">djdis</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>ackermann_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf_transformations</depend>
  <exec_depend>autodrive_roboracer</exec_depend>
  <exec_depend>ackermann_mux</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>joy_teleop</exec_depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
