<?xml version="1.0"?>
<!--
  Minimal differential-drive robot with a lidar similar to the Hokuyo UST-10LX.
  Diff drive instead of Ackermann keeps the sandbox simple - SLAM only cares
  about the scans and the odom->base_link transform, not the steering geometry.
-->
<sdf version="1.8">
  <model name="car">

    <link name="base_link">
      <pose>0 0 0.06 0 0 0</pose>
      <!-- The model origin is the wheel axle centre (what DiffDrive odometry assumes).
           The chassis and mass sit behind it, resting on one rear caster: 3 contact
           points put ~70% of the weight on the drive wheels, so they don't slip. -->
      <inertial>
        <pose>-0.08 0 0 0 0 0</pose>
        <mass>3.0</mass>
        <inertia><ixx>0.02</ixx><iyy>0.05</iyy><izz>0.06</izz></inertia>
      </inertial>
      <collision name="chassis">
        <pose>-0.08 0 0 0 0 0</pose>
        <geometry><box><size>0.45 0.25 0.06</size></box></geometry>
      </collision>
      <visual name="chassis">
        <pose>-0.08 0 0 0 0 0</pose>
        <geometry><box><size>0.45 0.25 0.06</size></box></geometry>
        <material><ambient>0.8 0.1 0.1 1</ambient><diffuse>0.8 0.1 0.1 1</diffuse></material>
      </visual>

      <sensor name="lidar" type="gpu_lidar">
        <pose>0.1 0 0.08 0 0 0</pose>
        <topic>/scan</topic>
        <ignition_frame_id>laser</ignition_frame_id>
        <update_rate>40</update_rate>
        <always_on>true</always_on>
        <lidar>
          <scan>
            <horizontal>
              <samples>1081</samples>
              <resolution>1</resolution>
              <min_angle>-2.356194</min_angle>
              <max_angle>2.356194</max_angle>
            </horizontal>
            <vertical>
              <samples>1</samples>
              <resolution>1</resolution>
              <min_angle>0</min_angle>
              <max_angle>0</max_angle>
            </vertical>
          </scan>
          <range>
            <min>0.06</min>
            <max>30.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>

    <link name="left_wheel">
      <pose>0 0.15 0.05 -1.5707 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia><ixx>0.00015</ixx><iyy>0.00015</iyy><izz>0.00025</izz></inertia>
      </inertial>
      <!-- sphere instead of cylinder: cylinder contacts are unreliable in the default
           physics engine (DART) and make the wheels slip when turning -->
      <collision name="collision">
        <geometry><sphere><radius>0.05</radius></sphere></geometry>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <link name="right_wheel">
      <pose>0 -0.15 0.05 -1.5707 0 0</pose>
      <inertial>
        <mass>0.2</mass>
        <inertia><ixx>0.00015</ixx><iyy>0.00015</iyy><izz>0.00025</izz></inertia>
      </inertial>
      <!-- sphere instead of cylinder: cylinder contacts are unreliable in the default
           physics engine (DART) and make the wheels slip when turning -->
      <collision name="collision">
        <geometry><sphere><radius>0.05</radius></sphere></geometry>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.05</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>

    <!-- rear caster: a free-rolling ball on a ball joint (as in Gazebo's diff_drive example).
         A frictionless sphere fixed to the chassis still drags in DART. -->
    <link name="caster">
      <pose>-0.25 0 0.025 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><sphere><radius>0.025</radius></sphere></geometry>
      </collision>
    </link>

    <joint name="caster_joint" type="ball">
      <parent>base_link</parent>
      <child>caster</child>
    </joint>

    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1e16</lower><upper>1e16</upper></limit></axis>
    </joint>

    <!-- Drive: turns /cmd_vel into wheel speeds. Its wheel odometry is published on
         /wheel_odom only (not used by SLAM): the wheels slip on fast turns in this
         simple model, so wheel-counting odometry is unreliable here. -->
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.3</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <topic>/cmd_vel</topic>
      <odom_topic>/wheel_odom</odom_topic>
      <tf_topic>/wheel_odom/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_acceleration>4</max_linear_acceleration>
      <min_linear_acceleration>-4</min_linear_acceleration>
    </plugin>

    <!-- Odometry used by SLAM: /odom and the odom->base_link transform, from the car's
         true motion (so the odom frame = Gazebo world frame = Victoria map frame).
         Perfect odometry is an optimistic baseline - add noise on purpose to test robustness. -->
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/odom</odom_topic>
      <tf_topic>/model/car/tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

    <!-- Ground truth for pose_error: the true pose in the Gazebo world frame.
         Kept separate from /odom so odometry noise can be added later. -->
    <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>car</robot_base_frame>
      <odom_topic>/ground_truth</odom_topic>
      <tf_topic>/ground_truth/tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>

  </model>
</sdf>
